#!/bin/sh
# Generates, once, the secrets an install needs into $MYTHWEAVER_SECRETS_DIR (default
# /data/secrets): app.env (SECRET_KEY_BASE, MYTHWEAVER_VAULT_KEY) and xi.env (xtandard-image's
# XI_SIGNING_KEYS, XI_SIGNING_SALTS, XI_ENCRYPTION_KEYS, which the app reads as MYTHWEAVER_XI_*).
# An existing file is never rewritten: losing the vault key loses every stored API key.
set -eu

dir="${MYTHWEAVER_SECRETS_DIR:-/data/secrets}"
umask 077
mkdir -p "$dir"

write() {
  [ -s "$dir/$1" ] && return 0
  cat > "$dir/$1.tmp"
  mv "$dir/$1.tmp" "$dir/$1"
}

printf 'SECRET_KEY_BASE=%s\nMYTHWEAVER_VAULT_KEY=%s\n' \
  "$(openssl rand -base64 48 | tr -d '\n')" "$(openssl rand -base64 32)" | write app.env
printf 'XI_SIGNING_KEYS=%s\nXI_SIGNING_SALTS=%s\nXI_ENCRYPTION_KEYS=%s\n' \
  "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" | write xi.env
