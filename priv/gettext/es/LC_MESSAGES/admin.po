#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: ai.connections.create"
msgid "Add AI connections and models that only the user sees and runs."
msgstr "Añadir conexiones y modelos de IA que solo el usuario ve y ejecuta."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: ai.site_models.use"
msgid "Run the site's AI connections and models; off, only the user's own models work."
msgstr "Ejecutar las conexiones y modelos de IA del sitio; si está desactivado, solo funcionan los modelos propios del usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: analytics.all.view"
msgid "See generation analytics for every account."
msgstr "Ver las analíticas de generación de todas las cuentas."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: catalog.feature"
msgid "Feature and unfeature catalog listings."
msgstr "Destacar y dejar de destacar publicaciones del catálogo."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: catalog.publish"
msgid "Publish the user's own characters, lore, prompts, scripts and memory items to the catalog for anyone to subscribe to."
msgstr "Publicar en el catálogo los personajes, el lore, los prompts, los scripts y los elementos de memoria propios del usuario para que cualquiera se suscriba."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: chats.invite"
msgid "Invite other accounts by handle into the user's chats, as chat editors or guests."
msgstr "Invitar a otras cuentas por su identificador a los chats del usuario, como editores del chat o invitados."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: content.characters.create"
msgid "Keep characters only the user sees and edits."
msgstr "Tener personajes que solo el usuario ve y edita."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: content.lore.create"
msgid "Keep lore books, entries and pools only the user sees and edits."
msgstr "Tener libros de lore, entradas y grupos que solo el usuario ve y edita."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: content.memory.create"
msgid "Keep memory profiles, side prompts and side prompt sets only the user sees and edits."
msgstr "Tener perfiles de memoria, prompts secundarios y conjuntos de prompts secundarios que solo el usuario ve y edita."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: content.prompts.create"
msgid "Keep prompts, prompt blocks and outlets only the user sees and edits."
msgstr "Tener prompts, bloques de prompt y outlets que solo el usuario ve y edita."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: content.scripts.create"
msgid "Keep scripts only the user sees and edits."
msgstr "Tener scripts que solo el usuario ve y edita."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: content.tags.create"
msgid "Keep tags, siblings and parents only the user sees, and tag anything they can see."
msgstr "Tener etiquetas, hermanas y padres que solo el usuario ve, y etiquetar todo lo que pueda ver."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: content.variables.create"
msgid "Keep global variables only the user sees and edits."
msgstr "Tener variables globales que solo el usuario ve y edita."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: groups.manage"
msgid "Create groups, set their permissions and members, and set users' own permissions."
msgstr "Crear grupos, definir sus permisos y miembros, y definir los permisos propios de los usuarios."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: mcp.use"
msgid "Create MCP access tokens and use Mythweaver's tools from outside AI clients (Claude, Cursor and others) with them."
msgstr "Crear tokens de acceso MCP y usar con ellos las herramientas de Mythweaver desde clientes de IA externos (Claude, Cursor y otros)."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.accounts.sanction"
msgid "Warn accounts other than owners, suspend them for a time or for good, and lift suspensions."
msgstr "Advertir a cuentas que no sean de propietarios, suspenderlas temporal o permanentemente y levantar suspensiones."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.ai.permissive"
msgid "Check this account's AI connections and models against the moderation rules after saving; matches are flagged for review."
msgstr "Comprobar las conexiones y modelos de IA de esta cuenta con las reglas de moderación después de guardar; las coincidencias se marcan para revisión."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.ai.restrictive"
msgid "Keep new AI connections and models and their text edits in memory, unsaved, until the rules or a moderator approve them. Wins over scanning."
msgstr "Mantener las nuevas conexiones y modelos de IA y sus ediciones de texto en memoria, sin guardar, hasta que las reglas o un moderador los aprueben. Tiene prioridad sobre el escaneo."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.characters.permissive"
msgid "Check this account's characters against the moderation rules after saving; matches are flagged for review."
msgstr "Comprobar los personajes de esta cuenta con las reglas de moderación después de guardar; las coincidencias se marcan para revisión."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.characters.restrictive"
msgid "Keep new characters and character text edits in memory, unsaved, until the rules or a moderator approve them. Wins over scanning."
msgstr "Mantener los nuevos personajes y las ediciones de texto de personajes en memoria, sin guardar, hasta que las reglas o un moderador los aprueben. Tiene prioridad sobre el escaneo."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.chats.permissive"
msgid "Check this account's chat names and the messages it writes against the moderation rules after saving; matches are flagged for review."
msgstr "Comprobar los nombres de chat de esta cuenta y los mensajes que escribe con las reglas de moderación después de guardar; las coincidencias se marcan para revisión."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.content.delete"
msgid "Delete any account's chats, messages and content, take down catalog listings, and move users' lore books to the site (with site content management)."
msgstr "Eliminar chats, mensajes y contenido de cualquier cuenta, retirar publicaciones del catálogo y mover libros de lore de usuarios al sitio (con gestión del contenido del sitio)."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.content.view"
msgid "Look up and read any account's chats, messages and content by link, id or handle. Every look is written to the moderation log."
msgstr "Consultar y leer chats, mensajes y contenido de cualquier cuenta por enlace, id o identificador. Cada consulta se registra en el registro de moderación."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.fingerprints"
msgid "See an account's IP addresses, browsers, devices and the accounts that share them, and ban devices, browser fingerprints and IP addresses."
msgstr "Ver las direcciones IP, navegadores y dispositivos de una cuenta y las cuentas que los comparten, y bloquear dispositivos, huellas de navegador y direcciones IP."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.log.view"
msgid "See every moderation action and every look at private content."
msgstr "Ver cada acción de moderación y cada consulta de contenido privado."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.lore.permissive"
msgid "Check this account's lore books and entries against the moderation rules after saving; matches are flagged for review."
msgstr "Comprobar los libros de lore y las entradas de esta cuenta con las reglas de moderación después de guardar; las coincidencias se marcan para revisión."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.lore.restrictive"
msgid "Keep new lore entries and lore entry text edits in memory, unsaved, until the rules or a moderator approve them; lore books are scanned. Wins over scanning."
msgstr "Mantener las nuevas entradas de lore y las ediciones de texto de entradas de lore en memoria, sin guardar, hasta que las reglas o un moderador las aprueben; los libros de lore se escanean. Tiene prioridad sobre el escaneo."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.prompts.permissive"
msgid "Check this account's prompts, blocks and outlets against the moderation rules after saving; matches are flagged for review."
msgstr "Comprobar los prompts, bloques y outlets de esta cuenta con las reglas de moderación después de guardar; las coincidencias se marcan para revisión."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.prompts.restrictive"
msgid "Keep new prompts, blocks and outlets and their text edits in memory, unsaved, until the rules or a moderator approve them. Wins over scanning."
msgstr "Mantener los nuevos prompts, bloques y outlets y sus ediciones de texto en memoria, sin guardar, hasta que las reglas o un moderador los aprueben. Tiene prioridad sobre el escaneo."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.reports"
msgid "See reported catalog listings, accounts and messages, and dismiss reports."
msgstr "Ver las publicaciones del catálogo, cuentas y mensajes denunciados, y descartar denuncias."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.review"
msgid "See content the moderation rules flagged and content held for review; approve, reject or dismiss it."
msgstr "Ver el contenido marcado por las reglas de moderación y el contenido retenido para revisión; aprobarlo, rechazarlo o descartarlo."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: moderation.rules.manage"
msgid "Create, edit and delete the regex and webhook rules every moderated save is checked against."
msgstr "Crear, editar y eliminar las reglas de regex y webhook con las que se comprueba cada guardado moderado."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.ai_connections"
msgid "How many AI connections the user may own."
msgstr "Cuántas conexiones de IA puede tener el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.ai_models"
msgid "How many AI models the user may own."
msgstr "Cuántos modelos de IA puede tener el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.characters"
msgid "How many characters the user may own."
msgstr "Cuántos personajes puede tener el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.chats"
msgid "How many chats the user may own."
msgstr "Cuántos chats puede tener el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.lore_books"
msgid "How many lore books the user may own."
msgstr "Cuántos libros de lore puede tener el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.pending_invites"
msgid "How many share and chat invites the user may have waiting for an answer."
msgstr "Cuántas invitaciones para compartir y a chats puede tener el usuario esperando respuesta."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.prompts"
msgid "How many prompts the user may own."
msgstr "Cuántos prompts puede tener el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.scripts"
msgid "How many scripts the user may own."
msgstr "Cuántos scripts puede tener el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.spend_per_day"
msgid "Dollars the user's replies, jobs and lore embeddings may cost in any 24 hours on connections the site provides: the connection's reported charge, else an estimate from the model's per-Mtok prices. A run on a model with neither counts as free. Their own connections are never limited."
msgstr "Dólares que pueden costar las respuestas, tareas y embeddings de lore del usuario en cualquier período de 24 horas en conexiones que proporciona el sitio: el cargo indicado por la conexión o, si no, una estimación a partir de los precios por Mtok del modelo. Una ejecución en un modelo sin ninguno de los dos cuenta como gratuita. Sus propias conexiones nunca se limitan."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: quota.upload_bytes"
msgid "How much the user's uploaded files may take up in total."
msgstr "Cuánto espacio pueden ocupar en total los archivos subidos por el usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: reports.create"
msgid "Report catalog listings, accounts and chat messages to the moderators. Everyone holds it by default; deny it for Everyone to turn reporting off."
msgstr "Denunciar publicaciones del catálogo, cuentas y mensajes de chat a los moderadores. «Everyone» lo tiene de forma predeterminada; deniégalo para «Everyone» para desactivar las denuncias."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.characters"
msgid "Let the user's scripts change characters and their avatars."
msgstr "Permitir que los scripts del usuario cambien personajes y sus avatares."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.generation"
msgid "Let the user's scripts start AI replies."
msgstr "Permitir que los scripts del usuario inicien respuestas de IA."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.images"
msgid "Let the user's scripts caption images and request new ones."
msgstr "Permitir que los scripts del usuario describan imágenes y soliciten otras nuevas."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.injections"
msgid "Let the user's scripts create, edit and delete a chat's injections."
msgstr "Permitir que los scripts del usuario creen, editen y eliminen las inyecciones de un chat."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.lore"
msgid "Let the user's scripts change lore books and entries."
msgstr "Permitir que los scripts del usuario cambien libros de lore y entradas."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.memory"
msgid "Let the user's scripts run memory jobs and change a chat's memory settings."
msgstr "Permitir que los scripts del usuario ejecuten tareas de memoria y cambien los ajustes de memoria de un chat."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.messages"
msgid "Let the user's scripts create, edit and delete messages."
msgstr "Permitir que los scripts del usuario creen, editen y eliminen mensajes."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.prompts"
msgid "Let the user's scripts switch a chat's prompt and toggle its blocks."
msgstr "Permitir que los scripts del usuario cambien el prompt de un chat y activen o desactiven sus bloques."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: scripts.variables"
msgid "Let the user's scripts set and delete a chat's variables and the user's own global variables."
msgstr "Permitir que los scripts del usuario definan y eliminen las variables de un chat y las variables globales propias del usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: sharing.ai.owner_key"
msgid "Let subscribers' runs on a shared model use this user's own AI connections and spend their key."
msgstr "Permitir que las ejecuciones de los suscriptores en un modelo compartido usen las conexiones de IA propias de este usuario y gasten su clave."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: sharing.invite"
msgid "Invite other accounts by handle to edit the user's characters, lore, prompts, scripts and memory items."
msgstr "Invitar a otras cuentas por su identificador a editar los personajes, el lore, los prompts, los scripts y los elementos de memoria del usuario."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: site.ai.manage"
msgid "Create and edit the site's shared AI connections and models."
msgstr "Crear y editar las conexiones y modelos de IA compartidos del sitio."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: site.cleanup.run"
msgid "Run the message cleanup over every chat in the app, with the site's cleanup settings."
msgstr "Ejecutar la limpieza de mensajes en todos los chats de la aplicación, con los ajustes de limpieza del sitio."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: site.content.manage"
msgid "Create and edit the site's shared characters, lore, prompts, scripts, memory and variables."
msgstr "Crear y editar los personajes, el lore, los prompts, los scripts, la memoria y las variables compartidos del sitio."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: site.hidden.view"
msgid "See the protected content of site items hidden from users: runtime-only characters, prompts, blocks and scripts, and runtime-only or hidden lore."
msgstr "Ver el contenido protegido de elementos del sitio ocultos a los usuarios: personajes, prompts, bloques y scripts solo de ejecución, y lore solo de ejecución u oculto."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: site.settings.manage"
msgid "Change site-wide setting defaults and lock settings users may not override."
msgstr "Cambiar los valores predeterminados de los ajustes de todo el sitio y bloquear ajustes que los usuarios no pueden modificar."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: uploads.audio"
msgid "Attach audio clips to messages; models that hear audio get the clip."
msgstr "Adjuntar clips de audio a mensajes; los modelos que oyen audio reciben el clip."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: uploads.documents"
msgid "Attach PDFs and text or Markdown files to messages; models read their text, or the PDF itself."
msgstr "Adjuntar PDF y archivos de texto o Markdown a mensajes; los modelos leen su texto o el propio PDF."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: uploads.files"
msgid "Attach any other file to messages, offered as a download; models see only its name."
msgstr "Adjuntar cualquier otro archivo a mensajes, ofrecido como descarga; los modelos solo ven su nombre."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: uploads.images"
msgid "Attach PNG, JPEG and WebP images to messages, and upload avatars."
msgstr "Adjuntar imágenes PNG, JPEG y WebP a mensajes y subir avatares."

#: lib/mythweaver/permissions/catalog.ex
#, elixir-autogen, elixir-format
msgctxt "permission description: uploads.video"
msgid "Attach video clips to messages, played in the chat; models that watch video get the clip."
msgstr "Adjuntar clips de vídeo a mensajes, reproducidos en el chat; los modelos que ven vídeo reciben el clip."

#: lib/mythweaver/permissions/catalog.ex
