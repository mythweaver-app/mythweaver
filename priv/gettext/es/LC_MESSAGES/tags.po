msgstr "%{tag_format}, p. ej. %{example_tag}; se guarda en minúsculas"

#: lib/mythweaver_web/live/tag_live.ex
#, elixir-autogen, elixir-format
msgid "A personal tag is yours alone: no other user, admin or not, sees it or its rules. Site tags, siblings and parents are seen by every user, and only admins edit them."
msgstr "Una etiqueta personal es solo tuya: ningún otro usuario, sea administrador o no, la ve ni ve sus reglas. Las etiquetas del sitio, sus hermanas y sus padres las ven todos los usuarios, y solo los administradores las editan."

#: lib/mythweaver_web/live/tag_live.ex
#, elixir-autogen, elixir-format
msgid "A sibling: wherever this tag appears, show that one instead."
msgstr "Una hermana: dondequiera que aparezca esta etiqueta, se muestra esa en su lugar."

#. Error flash when the tag form has invalid fields.
