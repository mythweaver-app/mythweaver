#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "\"new\", \"regenerate\", \"continue\" or \"refine\"."
msgstr "\"new\", \"regenerate\", \"continue\" o \"refine\"."

#. Flash when a Lua script was saved but writing its tags failed.
#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "%{script_name} saved, but its tags did not"
msgstr "%{script_name} guardado, pero sus etiquetas no"

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "A button above the chat composer, labelled with the script's name, and a command palette entry \"quick reply: <name>\". Runs when either is clicked or picked, in a chat with a player character. Buttons are ordered by priority (higher first), then name."
msgstr "Un botón sobre el editor del chat, con el nombre del script, y una entrada de la paleta de comandos \"quick reply: <name>\". Se ejecuta al hacer clic en cualquiera de ellos o al elegirlo, en un chat con personaje del jugador. Los botones se ordenan por prioridad (mayor primero) y luego por nombre."

#. Flash when the Lua script form has errors.
#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Could not save — see the highlighted fields"
msgstr "No se pudo guardar: revisa los campos resaltados"

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Each book with at least one activated entry, once."
msgstr "Cada libro con al menos una entrada activada, una vez."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Each run gets a global %{event_table} table describing what fired it. Every event has:"
msgstr "Cada ejecución recibe una tabla global %{event_table} que describe qué la provocó. Todo evento tiene:"

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Every activated entry, with the book it activated from."
msgstr "Cada entrada activada, con el libro desde el que se activó."

#. Default sample text in the script test form; the asterisks mark a roleplay action.
#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Hello there! *waves* How are you today?"
msgstr "¡Hola! *saluda con la mano* ¿Qué tal estás hoy?"

#. Script reference footer. %{host_tables} and %{regex_functions} are comma-separated lists of Lua function names, %{refusal} and %{print_function} are Lua code, %{replacement_syntax} is the literal replacement syntax; none are translated.
#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Host functions: %{host_tables}. A refusal returns %{refusal}; a wrong argument fails the script. Regular expressions (PCRE): %{regex_functions}. Flags: i m s x U. Replacement strings use %{replacement_syntax}. %{print_function} shows its arguments with the run's script errors."
msgstr "Funciones del host: %{host_tables}. Un rechazo devuelve %{refusal}; un argumento incorrecto hace fallar el script. Expresiones regulares (PCRE): %{regex_functions}. Flags: i m s x U. Las cadenas de reemplazo usan %{replacement_syntax}. %{print_function} muestra sus argumentos junto con los errores de script de la ejecución."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "Inline script %{block_number} printed: %{printed_text}"
msgstr "El script en línea %{block_number} imprimió: %{printed_text}"

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "Must be a whole number."
msgstr "Debe ser un número entero."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "Must be one of: %{choice_list}"
msgstr "Debe ser uno de: %{choice_list}"

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "Must be true or false."
msgstr "Debe ser true o false."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "Not a participant of this chat."
msgstr "No es participante de este chat."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "Not run: dependency \"%{script_name}\" did not succeed."
msgstr "No ejecutado: la dependencia \"%{script_name}\" no tuvo éxito."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Ran without errors. This trigger ignores return values."
msgstr "Se ejecutó sin errores. Este disparador ignora los valores devueltos."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Ran without errors; it shows:"
msgstr "Se ejecutó sin errores; muestra:"

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Ran without errors; no notice."
msgstr "Se ejecutó sin errores; sin aviso."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Ran without errors; the composer is emptied."
msgstr "Se ejecutó sin errores; el editor se vacía."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Ran without errors; the composer is left alone."
msgstr "Se ejecutó sin errores; el editor no se toca."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Ran without errors; the text is unchanged."
msgstr "Se ejecutó sin errores; el texto no cambia."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Return a string or number to put in the block's place, or nothing (or nil) to remove the block. If the whole message is then blank and has no images, nothing is posted."
msgstr "Devuelve una cadena o un número para ponerlo en lugar del bloque, o nada (o nil) para quitar el bloque. Si el mensaje entero queda vacío y no tiene imágenes, no se publica nada."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Return a string or number to show it as a notice; nil or nothing shows none. Off a chat page chat_id is nil and mw.messages.*, mw.images.*, mw.generation.*, mw.memory.*, mw.vars.*, mw.injections.* and mw.lore.set_chat_bound return nil, \"no_chat\"."
msgstr "Devuelve una cadena o un número para mostrarlo como aviso; nil o nada no muestra ninguno. Fuera de una página de chat, chat_id es nil y mw.messages.*, mw.images.*, mw.generation.*, mw.memory.*, mw.vars.*, mw.injections.* y mw.lore.set_chat_bound devuelven nil, \"no_chat\"."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Return a string to put it in the composer in place of what is there. Return {\"message\", text} to send text as if typed and sent: templates, {! !} blocks and user_message scripts run, staged images go with it, and the composer is cleared. Return {\"clear\"} to empty the composer. nil or nothing changes nothing."
msgstr "Devuelve una cadena para ponerla en el editor en lugar de lo que haya. Devuelve {\"message\", text} para enviar el texto como si se hubiera escrito y enviado: se ejecutan las plantillas, los bloques {! !} y los scripts user_message, las imágenes preparadas se envían con él y el editor se vacía. Devuelve {\"clear\"} para vaciar el editor. nil o nada no cambia nada."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Return a string to replace the saved description, or nil (or nothing) to keep it; blank is ignored. mw.images.set_description here saves without running this trigger again. mw.generation.* is refused here."
msgstr "Devuelve una cadena para reemplazar la descripción guardada, o nil (o nada) para conservarla; una vacía se ignora. Aquí mw.images.set_description guarda sin volver a ejecutar este disparador. Aquí se rechaza mw.generation.*."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Return a string to replace the saved text, or nil (or nothing) to keep it. The prompt inspector still shows what the model sent. mw.generation.* is refused here."
msgstr "Devuelve una cadena para reemplazar el texto guardado, o nil (o nada) para conservarlo. El inspector de prompts sigue mostrando lo que envió el modelo. Aquí se rechaza mw.generation.*."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Return a string to replace the text, or nil (or nothing) to keep it. Returning blank text cancels a send unless images are attached; a blank edit is refused."
msgstr "Devuelve una cadena para reemplazar el texto, o nil (o nada) para conservarlo. Devolver texto vacío cancela un envío salvo que haya imágenes adjuntas; una edición vacía se rechaza."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Return values are ignored. Changes to lore or prompts apply from the next generation, because this one's prompt is already built. mw.generation.* is refused here."
msgstr "Los valores devueltos se ignoran. Los cambios en el lore o los prompts se aplican desde la siguiente generación, porque el prompt de esta ya está construido. Aquí se rechaza mw.generation.*."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Runs from the command palette (Cmd-P / Ctrl-P) as \"lua: <name>\". Declare its inputs with ---@param lines at the top; see the event reference below."
msgstr "Se ejecuta desde la paleta de comandos (Cmd-P / Ctrl-P) como \"lua: <name>\". Declara sus entradas con líneas ---@param al principio; consulta la referencia de eventos más abajo."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Runs once when a message containing {! … !} is sent from the composer; the block is never stored. Blocks run in order; a syntax error in any block blocks the send, and a runtime error stops the send at that block."
msgstr "Se ejecuta una vez cuando se envía desde el editor un mensaje que contiene {! … !}; el bloque nunca se guarda. Los bloques se ejecutan en orden; un error de sintaxis en cualquier bloque impide el envío, y un error de ejecución detiene el envío en ese bloque."

#. Hint in the script test section. The placeholders are Lua code, shown as code and not translated.
#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Runs the script above, saved or not, with this text as %{event_text} and empty sample values for the other fields. Nothing is changed: %{mw_functions} functions that need a chat or change data return %{test_run_result}."
msgstr "Ejecuta el script de arriba, guardado o no, con este texto como %{event_text} y valores de ejemplo vacíos para los demás campos. No se cambia nada: las funciones %{mw_functions} que necesitan un chat o cambian datos devuelven %{test_run_result}."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Runs when a generation activates lore, after the lore is resolved and before the prompt is sent."
msgstr "Se ejecuta cuando una generación activa lore, después de resolver el lore y antes de enviar el prompt."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Runs when an AI reply finishes successfully, before it is saved. A stopped or failed reply runs no scripts."
msgstr "Se ejecuta cuando una respuesta de IA termina correctamente, antes de guardarse. Una respuesta detenida o fallida no ejecuta scripts."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Runs when an image in a chat gets a description: from a caption model, typed by a person, or set by a script outside this trigger. Before replies waiting on the caption read it. Avatars run no scripts. Only the chat owner's own descriptions run them; another member's run none."
msgstr "Se ejecuta cuando una imagen de un chat recibe una descripción: de un modelo de descripción, escrita por una persona o puesta por un script fuera de este disparador. Las respuestas que esperan la descripción la leen después. Los avatares no ejecutan scripts. Solo las descripciones del propio propietario del chat los ejecutan; las de otro miembro no ejecutan ninguno."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Runs when picked from the command palette (Cmd-P / Ctrl-P) as \"lua: <name>\". Declare its inputs with --- comment lines at the very top: \"---@param name type Label\" (name? for an optional one), other \"---\" text is the command's description, and other ---@ tags are ignored. Types: string, integer, number, boolean, character, participant, message, lore_book, lore_entry, prompt, prompt_block, model, chat, script, or choices \"a\"|\"b\". A participant or message parameter offers the command only in a chat. Other scripts can call it with mw.commands.run(name, args); it then runs with the caller's event and trigger, only event.args replaced, and its return values go back to the caller unchanged."
msgstr "Se ejecuta al elegirlo en la paleta de comandos (Cmd-P / Ctrl-P) como \"lua: <name>\". Declara sus entradas con líneas de comentario --- al principio del todo: \"---@param name type Label\" (name? para una opcional); el resto del texto \"---\" es la descripción del comando, y las demás etiquetas ---@ se ignoran. Tipos: string, integer, number, boolean, character, participant, message, lore_book, lore_entry, prompt, prompt_block, model, chat, script, u opciones \"a\"|\"b\". Un parámetro participant o message ofrece el comando solo en un chat. Otros scripts pueden llamarlo con mw.commands.run(name, args); entonces se ejecuta con el evento y el disparador de quien lo llama, sustituyendo solo event.args, y sus valores devueltos vuelven sin cambios a quien lo llamó."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "Runs when the player sends a message or saves an edit, before it is stored. Blank text with no images skips scripts. Only the chat owner's own messages run them; another member's run none."
msgstr "Se ejecuta cuando el jugador envía un mensaje o guarda una edición, antes de guardarse. El texto vacío sin imágenes omite los scripts. Solo los mensajes del propio propietario del chat los ejecutan; los de otro miembro no ejecutan ninguno."

#: lib/mythweaver/scripts/sandbox.ex
#, elixir-autogen, elixir-format
msgid "Script exceeded its CPU time limit of %{time_limit_ms} ms."
msgstr "El script superó su límite de tiempo de CPU de %{time_limit_ms} ms."

#: lib/mythweaver/scripts/sandbox.ex
#, elixir-autogen, elixir-format
msgid "Script exceeded its memory limit of %{memory_limit}."
msgstr "El script superó su límite de memoria de %{memory_limit}."

#: lib/mythweaver/scripts/sandbox.ex
#, elixir-autogen, elixir-format
msgid "Script exceeded its time limit of %{time_limit_ms} ms."
msgstr "El script superó su límite de tiempo de %{time_limit_ms} ms."

#: lib/mythweaver/scripts/sandbox.ex
#, elixir-autogen, elixir-format
msgid "Script is too complex to parse within the memory limit."
msgstr "El script es demasiado complejo para analizarlo dentro del límite de memoria."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "Script must return a string or nil."
msgstr "El script debe devolver una cadena o nil."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Script reference: the %{event_table} table"
msgstr "Referencia de scripts: la tabla %{event_table}"

#: lib/mythweaver/scripts/sandbox.ex
#, elixir-autogen, elixir-format
msgid "Script took too long to parse."
msgstr "El análisis del script tardó demasiado."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Select a script, or create a new one."
msgstr "Selecciona un script o crea uno nuevo."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "Shows as a button named after this script above the chat composer, and in the command palette as \"quick reply: <name>\". Gets the composer text as event.text; see the event reference below."
msgstr "Aparece como un botón con el nombre de este script sobre el editor del chat, y en la paleta de comandos como \"quick reply: <name>\". Recibe el texto del editor como event.text; consulta la referencia de eventos más abajo."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That character no longer exists."
msgstr "Ese personaje ya no existe."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That chat no longer exists."
msgstr "Ese chat ya no existe."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "That command script no longer exists or is disabled."
msgstr "Ese script de comando ya no existe o está desactivado."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That lore book no longer exists."
msgstr "Ese libro de lore ya no existe."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That lore entry no longer exists."
msgstr "Esa entrada de lore ya no existe."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That message no longer exists."
msgstr "Ese mensaje ya no existe."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That model no longer exists."
msgstr "Ese modelo ya no existe."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That prompt block no longer exists."
msgstr "Ese bloque de prompt ya no existe."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That prompt no longer exists."
msgstr "Ese prompt ya no existe."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "That quick reply no longer exists or is disabled."
msgstr "Esa respuesta rápida ya no existe o está desactivada."

#: lib/mythweaver/scripts/command.ex
#, elixir-autogen, elixir-format
msgid "That script no longer exists."
msgstr "Ese script ya no existe."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The author: the chat's player for a new message, the message's author for an edit."
msgstr "El autor: el jugador del chat para un mensaje nuevo, el autor del mensaje para una edición."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The caption model, when by is \"model\"."
msgstr "El modelo de descripción, cuando by es \"model\"."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The character about to speak."
msgstr "El personaje que va a hablar."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "The chat no longer exists."
msgstr "El chat ya no existe."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The chat the event happened in. `mw.messages.*`, `mw.generation.*`, `mw.memory.*`, `mw.vars.*` and `mw.injections.*` act on it."
msgstr "El chat en el que ocurrió el evento. `mw.messages.*`, `mw.generation.*`, `mw.memory.*`, `mw.vars.*` y `mw.injections.*` actúan sobre él."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The edited message, or nil for a new message."
msgstr "El mensaje editado, o nil para un mensaje nuevo."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The ids of the images being sent."
msgstr "Los ids de las imágenes que se envían."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The ids of the images sent with the message (already stored, so mw.images.get and mw.images.caption work on them), or the edited message's images."
msgstr "Los ids de las imágenes enviadas con el mensaje (ya guardadas, así que mw.images.get y mw.images.caption funcionan con ellas), o las imágenes del mensaje editado."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The message text after template rendering. A script earlier in the run order may already have rewritten it."
msgstr "El texto del mensaje tras renderizar las plantillas. Un script anterior en el orden de ejecución puede haberlo reescrito ya."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The message the image belongs to, or nil for an image still in the composer."
msgstr "El mensaje al que pertenece la imagen, o nil para una imagen que sigue en el editor."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The message the reply is written into."
msgstr "El mensaje en el que se escribe la respuesta."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The new description. A script earlier in the run order may already have rewritten it."
msgstr "La nueva descripción. Un script anterior en el orden de ejecución puede haberla reescrito ya."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The opts.data passed alongside the tag, as given, or nil. Held in memory: nil after a server restart."
msgstr "El opts.data pasado junto con la etiqueta, tal como se dio, o nil. Se guarda en memoria: nil tras reiniciar el servidor."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The parameters by name: text for string and choices, numbers, booleans, and record tables for entities (a character or participant is a character table, a message a message table, a lore book or entry, prompt or prompt block its table, model {id, name, api_model_id, completion_mode}, chat {id, name}, script {id, name, description, trigger, enabled}). A blank optional parameter is nil."
msgstr "Los parámetros por nombre: texto para string y opciones, números, booleanos y tablas de registro para entidades (un character o participant es una tabla de personaje, un message una tabla de mensaje, un libro o entrada de lore, prompt o bloque de prompt su tabla, model {id, name, api_model_id, completion_mode}, chat {id, name}, script {id, name, description, trigger, enabled}). Un parámetro opcional vacío es nil."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The player character sending the message."
msgstr "El personaje del jugador que envía el mensaje."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The reply's full text. A continue includes the original text before the new part. A script earlier in the run order may already have rewritten it."
msgstr "El texto completo de la respuesta. Una continuación incluye el texto original antes de la parte nueva. Un script anterior en el orden de ejecución puede haberlo reescrito ya."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "The script does not end with return, so it returns nothing and the text stays as it was. End it with return and the new text, or return nil to keep the text on purpose."
msgstr "El script no termina con return, así que no devuelve nada y el texto se queda como estaba. Termínalo con return y el texto nuevo, o con return nil para conservar el texto a propósito."

#. Flash shown when the script open in the editor was deleted or moved by someone else.
#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "The script was deleted or moved elsewhere."
msgstr "El script se eliminó o se movió a otro lugar."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The tag passed to mw.images.caption(id, {tag = ...}) or to the mw.images.request(prompt, {tag = ...}) that brought the image, or nil."
msgstr "La etiqueta pasada a mw.images.caption(id, {tag = ...}) o al mw.images.request(prompt, {tag = ...}) que trajo la imagen, o nil."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "The trigger that ran this script, e.g. \"user_message\"."
msgstr "El disparador que ejecutó este script, p. ej. \"user_message\"."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "This block's position among the message's {! !} blocks, from 1."
msgstr "La posición de este bloque entre los bloques {! !} del mensaje, desde 1."

#: lib/mythweaver/scripts/event_reference.ex
#, elixir-autogen, elixir-format
msgid "What is in the composer when it runs; may be blank."
msgstr "Lo que hay en el editor cuando se ejecuta; puede estar vacío."

#: lib/mythweaver_web/live/script_live.ex
#, elixir-autogen, elixir-format
msgid "What users who are not admins see of this script. Only names: never its body, in the assistant, scripts or exports; it still runs. Admins always see everything."
msgstr "Lo que ven de este script los usuarios que no son administradores. Solo nombres: nunca su cuerpo, ni en el asistente, los scripts o las exportaciones; sigue ejecutándose. Los administradores siempre lo ven todo."

#: lib/mythweaver/scripts.ex
#, elixir-autogen, elixir-format
msgid "You're not allowed to do that."
