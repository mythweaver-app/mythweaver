#. Flash after a moderator moved a user's lore book to the site.
#: lib/mythweaver_web/live/user_data_live.ex
#, elixir-autogen, elixir-format
msgid "%{book_name} is now a site book"
msgstr "%{book_name} ahora es un libro del sitio"

#. The endpoint is the server's MCP URL and the header is the literal HTTP header Authorization: Bearer <token>, both shown as code.
#: lib/mythweaver_web/live/user_settings_live.ex
#, elixir-autogen, elixir-format
msgid "Connect AI clients such as Claude, Cursor or Codex to Mythweaver over MCP. The endpoint is %{endpoint}; clients send %{auth_header}. A read-only token sees only reading tools. A full-access token can use every tool but never your site administration or moderation permissions; a site token, if you hold them, can. Write tools run as soon as the client calls them."
msgstr "Conecta clientes de IA como Claude, Cursor o Codex a Mythweaver mediante MCP. El endpoint es %{endpoint}; los clientes envían %{auth_header}. Un token de solo lectura solo ve las herramientas de lectura. Un token de acceso total puede usar todas las herramientas, pero nunca tus permisos de administración o moderación del sitio; un token de sitio sí puede, si los tienes. Las herramientas de escritura se ejecutan en cuanto el cliente las llama."

#: lib/mythweaver_web/live/user_settings_live.ex
#, elixir-autogen, elixir-format
msgid "Copy this token now; it is not shown again."
msgstr "Copia este token ahora; no se volverá a mostrar."

#: lib/mythweaver_web/live/user_setup_live.ex
#, elixir-autogen, elixir-format
msgid "Create the first account. Every account is an administrator."
msgstr "Crea la primera cuenta. Todas las cuentas son de administrador."

#: lib/mythweaver_web/sudo.ex
#, elixir-autogen, elixir-format
msgid "Enter your password to continue. You won't be asked again for 15 minutes."
msgstr "Escribe tu contraseña para continuar. No se te volverá a pedir durante 15 minutos."

