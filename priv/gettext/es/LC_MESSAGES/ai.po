#, elixir-autogen, elixir-format
msgctxt "status: flash after linking a model to an AI connection"
msgid "%{model_name} linked"
msgstr "%{model_name} enlazado"

#. Flash when listing a connection's models crashed. %{error_detail} is an internal error term.
#: lib/mythweaver_web/live/ai_provider_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after listing a connection's models crashed"
msgid "Discovery crashed: %{error_detail}"
msgstr "El descubrimiento falló inesperadamente: %{error_detail}"

#. Flash when listing a connection's models fails. %{error_detail} is an internal error term.
#: lib/mythweaver_web/live/ai_provider_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after listing a connection's models failed"
msgid "Discovery failed: %{error_detail}"
msgstr "El descubrimiento falló: %{error_detail}"

#. Flash after a model link's settings were saved.
#: lib/mythweaver_web/live/ai_provider_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after saving a model link's settings"
msgid "%{model_name} updated"
msgstr "%{model_name} actualizado"

#. Flash after an AI connection was saved.
#: lib/mythweaver_web/live/ai_provider_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after saving an AI connection"
