msgstr "Pedir salida estructurada"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: generation.max_context"
msgid "Max context"
msgstr "Contexto máximo"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: generation.names_as_stop_strings"
msgid "Stop at other speakers' names"
msgstr "Detenerse en los nombres de otros hablantes"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: generation.single_line"
msgid "Single-line replies"
msgstr "Respuestas de una sola línea"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: generation.swipes_per_generation"
msgid "Swipes per reply"
msgstr "Variantes por respuesta"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: generation.trim_own_name"
msgid "Remove the speaker's own name"
msgstr "Quitar el nombre del propio hablante"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: generation.trim_step"
msgid "Trim in steps of"
msgstr "Recortar en pasos de"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: images.ask_every_time"
msgid "Ask every time"
msgstr "Preguntar siempre"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: images.auto_caption"
msgid "Describe images automatically"
msgstr "Describir imágenes automáticamente"

#: lib/mythweaver/settings.ex
#, elixir-autogen, elixir-format
msgctxt "setting name: images.avatar_caption_prompt"
msgid "Avatar caption prompt"
msgstr "Prompt de descripción de avatares"

#: lib/mythweaver/settings.ex
