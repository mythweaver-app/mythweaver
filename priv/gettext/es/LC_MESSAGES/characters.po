#. Shown when a new outfit is refused; the error is a validation message such as "can't be blank".
#: lib/mythweaver_web/live/character_live/expressions.ex
#, elixir-autogen, elixir-format
msgctxt "status: a new outfit was refused because of its name"
msgid "Outfit name %{error_message}"
msgstr "Nombre del atuendo: %{error_message}"

#. Shown under the sprite drop zone when an uploaded file is refused; the error is a sentence fragment such as "File is too large".
#: lib/mythweaver_web/live/character_live/expressions.ex
#, elixir-autogen, elixir-format
msgctxt "status: a sprite file upload was refused"
msgid "%{file_name}: %{upload_error}"
msgstr "%{file_name}: %{upload_error}"

#. Confirm dialog before deleting a character.
#: lib/mythweaver_web/live/character_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: confirm dialog before deleting a character"
msgid "Delete %{character_name}?"
msgstr "¿Eliminar a %{character_name}?"

#. Shown in the sprite panel after a sprite pack import; %{expression_labels} is a list of expression labels, such as "happy and sad".
#: lib/mythweaver_web/live/character_live/expressions.ex
#, elixir-autogen, elixir-format
msgctxt "status: expression labels added by a sprite pack import"
msgid "New expressions: %{expression_labels}"
msgstr "Nuevas expresiones: %{expression_labels}"

#. Shown in the sprite panel after a sprite pack import; %{file_names} is a list of the pack's file names that were not imported.
#: lib/mythweaver_web/live/character_live/expressions.ex
#, elixir-autogen, elixir-format
msgctxt "status: files a sprite pack import skipped"
msgid "Skipped: %{file_names}"
msgstr "Omitidos: %{file_names}"

#. Flash when a character avatar upload is refused; the error is a sentence fragment such as "File is too large".
#: lib/mythweaver_web/live/character_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after a character avatar upload was refused"
msgid "Avatar not uploaded: %{upload_error}"
msgstr "Avatar no subido: %{upload_error}"

#. Flash when a saved character's new avatar could not be stored.
#: lib/mythweaver_web/live/character_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after a character's new avatar could not be stored"
msgid "Avatar not saved"
msgstr "Avatar no guardado"

#. Flash after deleting a shared character hands it to another user; the placeholder is their handle without the @.
#: lib/mythweaver_web/live/character_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after a deleted shared character was handed to another user"
msgid "Given to @%{user_handle}"
msgstr "Entregado a @%{user_handle}"

#. Flash after a character is deleted.
#: lib/mythweaver_web/live/character_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after deleting a character"
msgid "%{character_name} deleted"
msgstr "%{character_name} eliminado"

#. Flash after an expression rule profile is deleted.
#: lib/mythweaver_web/live/expression_profile_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after deleting an expression rule profile"
msgid "%{profile_name} deleted"
msgstr "%{profile_name} eliminado"

#. Flash after an expression rule profile is saved.
#: lib/mythweaver_web/live/expression_profile_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash after saving an expression rule profile"
msgid "%{profile_name} saved"
msgstr "%{profile_name} guardado"

#. Flash when the character in the URL does not exist or cannot be edited.
#: lib/mythweaver_web/live/character_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash when a character could not be found"
msgid "Character not found"
msgstr "Personaje no encontrado"

#. Flash when the expression profile in the URL does not exist or cannot be edited.
#: lib/mythweaver_web/live/expression_profile_live.ex
#, elixir-autogen, elixir-format
msgctxt "status: flash when an expression rule profile could not be found"
msgid "Expression profile not found"
msgstr "Perfil de expresiones no encontrado"

#. Shown in the sprite panel after a sprite pack import; %{outfit_names} is a list of outfit names, such as "Casual and Formal".
#: lib/mythweaver_web/live/character_live/expressions.ex
#, elixir-autogen, elixir-format
msgctxt "status: outfits created by a sprite pack import"
msgid "New outfits: %{outfit_names}"
msgstr "Nuevos atuendos: %{outfit_names}"

#. Shown in the sprite panel when removing an expression label from the character failed.
#: lib/mythweaver_web/live/character_live/expressions.ex
#, elixir-autogen, elixir-format
msgctxt "status: removing an expression label from a character failed"
msgid "Could not remove %{expression_label}"
msgstr "No se pudo quitar %{expression_label}"

#. Shown in the sprite panel after a sprite pack ZIP was imported.
#: lib/mythweaver_web/live/character_live/expressions.ex
#, elixir-autogen, elixir-format
msgctxt "status: sprites imported from a sprite pack"
msgid "Imported %{sprite_count} sprite"
msgid_plural "Imported %{sprite_count} sprites"
msgstr[0] "%{sprite_count} sprite importado"
msgstr[1] "%{sprite_count} sprites importados"
