#: lib/mythweaver_web/components/command_palette.ex
#, elixir-autogen, elixir-format
msgid "Choose a PNG, JPEG or WebP image, or paste one"
msgstr "Wähle ein PNG-, JPEG- oder WebP-Bild oder füge eines ein"

#. Error flash when the palette command "chat: catch up memories" gets a bad Chunk size.
#: lib/mythweaver_web/components/command_palette/commands.ex
#, elixir-autogen, elixir-format
msgid "Chunk size must be 5 to 250 messages."
msgstr "Die Blockgröße muss 5 bis 250 Nachrichten betragen."

#. Error flash when a palette command gets a message number that is not a whole number from 1 up.
#: lib/mythweaver_web/components/command_palette/commands.ex
#, elixir-autogen, elixir-format
msgid "Message numbers start at 1."
msgstr "Nachrichtennummern beginnen bei 1."

#. Error flash when a palette command names a character who is not in the open chat.
#: lib/mythweaver_web/components/command_palette/commands.ex
#, elixir-autogen, elixir-format
msgid "Not a participant of this chat."
msgstr "Kein Teilnehmer dieses Chats."

#: lib/mythweaver_web/components/command_palette.ex
#, elixir-autogen, elixir-format
msgid "Pick one from the list."
msgstr "Wähle einen Eintrag aus der Liste."

#. Error flash when a palette command's Start message number is greater than its End; Start and End are the parameter labels.
#: lib/mythweaver_web/components/command_palette/commands.ex
#, elixir-autogen, elixir-format
msgid "Start must not be after End."
msgstr "Anfang darf nicht nach Ende liegen."

#. Error flash when a palette command acts on the last message of a chat that has none.
#: lib/mythweaver_web/components/command_palette/commands.ex
#, elixir-autogen, elixir-format
msgid "This chat has no messages yet."
msgstr "Dieser Chat hat noch keine Nachrichten."

#. Error flash when someone without the site cleanup permission runs "cleanup: all chats".
#: lib/mythweaver_web/components/command_palette/commands.ex
#, elixir-autogen, elixir-format
msgid "You can't clean up every user's chats."
msgstr "Du kannst nicht die Chats aller Benutzer bereinigen."

#. Error flash when "chat: edit last player message" runs before the player has sent anything.
#: lib/mythweaver_web/components/command_palette/commands.ex
#, elixir-autogen, elixir-format
msgid "You haven't sent a message in this chat yet."
msgstr "Du hast in diesem Chat noch keine Nachricht gesendet."

