// This file is needed on most editors to enable the intelligent autocompletion
// of LiveView's JavaScript API methods, and it is used by `bun run typecheck`
// (and the CI lint job) to type-check the first-party TypeScript sources.
//
// Bun also reads these `paths` when it bundles: `phoenix*` resolve from
// `../deps/*` through them, without a node_modules install of the Elixir deps.
// The colocated hooks are the exception: `build.ts` resolves
// `phoenix-colocated/*` itself from `_build/$MIX_ENV`, so the mapping to
// `_build/dev` below is for `tsc` and editors only.
//   * `phoenix` has no bundled types, so `tsc` maps it to `@types/phoenix`
//     (the same typings phoenix_live_view itself depends on).
//   * everything else resolves against `../deps/*` then `node_modules/*`.
{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "phoenix": ["node_modules/@types/phoenix"],
      "phoenix-colocated/*": ["../_build/dev/phoenix-colocated/*"],
      "*": ["../deps/*", "node_modules/*"]
    },
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*"]
}
