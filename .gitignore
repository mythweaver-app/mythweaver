# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
mythweaver-*.tar


# Bun build staging dirs (deterministic build source for the change-detecting copy).
/assets/.build-stage/
/assets/.build-stage-sw/

# Don't version compiled assets
priv/static/assets/css/*
priv/static/assets/js/*
/priv/static/sw.js
/priv/static/manifest.webmanifest

# Generated by the iconex compiler
/priv/static/images/iconex.svg

# Locally stored attachments (Mythweaver.Attachments.Storage.Local); the dir itself is kept so
# Docker bind mounts never create it as root.
/priv/uploads/*
!/priv/uploads/.gitkeep

# GeoLite2 databases (`mix mythweaver.geoip.download`); MaxMind's licence forbids committing them.
/priv/geoip/

# CLDR locale data (`mix localize.download_locales`), downloaded at setup and in the Dockerfile.
/priv/localize/

# Local Docker Compose settings: `.env` (e.g. MYTHWEAVER_NGINX_BIND) and `compose.override.yml`
# (extra nginx addresses, see `compose.yml`).
/.env
/compose.override.yml

# wip
todo.md

# docs
docs_site/_build/*
docs_site/_site/*
!docs_site/_site/404.html
/test-results/
research/
research/
