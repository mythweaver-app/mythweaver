amends "@pkl.impl.ghactions/PklCI.pkl"

import "@com.github.actions/catalog.pkl"
import "@com.github.actions/context.pkl"
import "@com.github.actions/Workflow.pkl"

local image = "ghcr.io/mythweaver-app/mythweaver"

// Pinned: mise.lock holds precompiled OTP for ubuntu-24.04.
local runner = "ubuntu-24.04"

local mise: Workflow.Step = new {
  name = "Install tools"
  uses = "jdx/mise-action@v5"
}

local login: Workflow.Step = new {
  name = "Log in to ghcr.io"
  uses = "docker/login-action@v4"
  with {
    ["registry"] = "ghcr.io"
    ["username"] = context.github.actor
    ["password"] = context.github.token
  }
}

local buildx: Workflow.Step = new {
  name = "Set up Docker Buildx"
  uses = "docker/setup-buildx-action@v4"
}

local test: Workflow.Job = new {
  `runs-on` = runner
  env {
    ["MIX_ENV"] = "test"
  }
  services {
    ["postgres"] {
      image = "pgvector/pgvector:pg18-trixie"
      env {
        ["POSTGRES_PASSWORD"] = "postgres"
      }
      ports {
        "5432:5432"
      }
      options = "--health-cmd pg_isready --health-interval 5s --health-timeout 5s --health-retries 20"
    }
  }
  steps {
    catalog.`actions/checkout@v6`
    mise
    (catalog.`actions/cache@v5`) {
      with {
        path = "deps\n_build\npriv/localize"
        key = "mix-${{ runner.os }}-${{ hashFiles('mix.lock', 'mise.lock') }}"
        `restore-keys` = "mix-${{ runner.os }}-"
      }
    }
    new {
      name = "Fetch dependencies"
      run = "mix deps.get"
    }
    new {
      name = "Download locales"
      run = "mix localize.download_locales"
    }
    new {
      name = "Check and test"
      run = "mix ci"
    }
  }
}

local platforms: Listing<Dynamic> = new {
  new { platform = "linux/amd64"; arch = "amd64"; runner = "ubuntu-24.04" }
  new { platform = "linux/arm64"; arch = "arm64"; runner = "ubuntu-24.04-arm" }
}

local cacheScope = "type=gha,scope=image-\(context.matrix("arch"))"

/// One image per platform, each on its native runner. With [push] it is pushed by digest for
/// [imageMerge]; with [tarball] the bare release is also packed as a tarball artifact.
local function imageBuild(push: Boolean, tarball: Boolean): Workflow.Job = new {
  `runs-on` = context.matrix("runner")
  strategy {
    matrix {
      ["include"] = platforms
    }
  }
  when (push) {
    permissions {
      contents = "read"
      packages = "write"
    }
  }
  steps {
    catalog.`actions/checkout@v6`
    buildx
    when (push) {
      login
    }
    new {
      id = "meta"
      name = "Image labels"
      uses = "docker/metadata-action@v6"
      with {
        ["images"] = image
      }
    }
    new {
      id = "build"
      name = "Build image"
      uses = "docker/build-push-action@v7"
      with {
        ["context"] = "."
        ["platforms"] = context.matrix("platform")
        ["labels"] = context.steps.outputs("meta", "labels")
        ["cache-from"] = cacheScope
        when (push) {
          ["outputs"] = "type=image,name=\(image),push-by-digest=true,name-canonical=true,push=true"
          ["cache-to"] = "\(cacheScope),mode=max"
        }
      }
    }
    when (push) {
      new {
        name = "Export digest"
        env {
          ["DIGEST"] = context.steps.outputs("build", "digest")
        }
        run = #"""
          mkdir -p "$RUNNER_TEMP/digests"
          touch "$RUNNER_TEMP/digests/${DIGEST#sha256:}"
          """#
      }
      (catalog.`actions/upload-artifact@v5`) {
        with {
          name = "digests-\(context.matrix("arch"))"
          path = "${{ runner.temp }}/digests/*"
          `if-no-files-found` = "error"
          `retention-days` = 1
        }
      }
    }
    when (tarball) {
      new {
        name = "Build release"
        uses = "docker/build-push-action@v7"
        with {
          ["context"] = "."
          ["target"] = "release"
          ["platforms"] = context.matrix("platform")
          ["outputs"] = "type=local,dest=out"
          ["cache-from"] = cacheScope
        }
      }
      new {
        name = "Pack release tarball"
        env {
          ["GIT_TAG"] = context.github.refName
          ["ARCH"] = context.matrix("arch")
        }
        run = #"tar -czf "mythweaver-${GIT_TAG#v}-linux-${ARCH}.tar.gz" -C out mythweaver"#
      }
      (catalog.`actions/upload-artifact@v5`) {
        with {
          name = "tarball-\(context.matrix("arch"))"
          path = "mythweaver-*.tar.gz"
          `if-no-files-found` = "error"
        }
      }
    }
  }
}

/// Joins the per-platform digests into one multi-arch image under [tags] (docker/metadata-action syntax).
local function imageMerge(tags: String): Workflow.Job = new {
  `runs-on` = runner
  needs = "image-build"
  permissions {
    contents = "read"
    packages = "write"
  }
  steps {
    (catalog.`actions/download-artifact@v6`) {
      with {
        path = "${{ runner.temp }}/digests"
        pattern = "digests-*"
        `merge-multiple` = true
      }
    }
    login
    buildx
    new {
      id = "meta"
      name = "Image tags"
      uses = "docker/metadata-action@v6"
      with {
        ["images"] = image
        ["tags"] = tags
      }
    }
    new {
      name = "Push the multi-arch image"
      shell = "bash"
      `working-directory` = "${{ runner.temp }}/digests"
      env {
        ["IMAGE"] = image
      }
      run = #"""
        docker buildx imagetools create \
          $(jq -cr '.tags | map("-t " + .) | join(" ")' <<< "$DOCKER_METADATA_OUTPUT_JSON") \
          $(printf "$IMAGE@sha256:%s " *)
        """#
    }
    new {
      name = "Inspect image"
      env {
        ["IMAGE"] = image
        ["VERSION"] = context.steps.outputs("meta", "version")
      }
      run = #"docker buildx imagetools inspect "$IMAGE:$VERSION""#
    }
  }
}

local checkVersion: Workflow.Job = new {
  `runs-on` = runner
  steps {
    catalog.`actions/checkout@v6`
    new {
      name = "Tag matches mix.exs"
      env {
        ["GIT_TAG"] = context.github.refName
      }
      run = #"""
        EXPECTED="v$(sed -n 's/^ *version: "\([^"]*\)",$/\1/p' mix.exs)"
        if [ "$GIT_TAG" != "$EXPECTED" ]; then
          echo "Tag $GIT_TAG does not match mix.exs's version ($EXPECTED). Fix one and re-tag."
          exit 1
        fi
        """#
    }
  }
}

local githubRelease: Workflow.Job = new {
  `runs-on` = runner
  needs = "image-merge"
  permissions {
    contents = "write"
  }
  steps {
    catalog.`actions/checkout@v6`
    (catalog.`actions/download-artifact@v6`) {
      with {
        path = "dist"
        pattern = "tarball-*"
        `merge-multiple` = true
      }
    }
    new {
      name = "Create the GitHub release"
      env {
        ["GIT_TAG"] = context.github.refName
        ["GH_REPO"] = context.github.repository
        ["GH_TOKEN"] = context.github.token
        ["IMAGE"] = image
      }
      run = #"""
        VERSION="${GIT_TAG#v}"
        sed "s|$IMAGE:latest|$IMAGE:$VERSION|g" deploy/compose.yml > dist/compose.yml
        grep -q "$IMAGE:$VERSION" dist/compose.yml
        (cd dist && sha256sum -- * > SHA256SUMS)
        case "$VERSION" in *-*) PRERELEASE=--prerelease ;; *) PRERELEASE= ;; esac
        gh release create "$GIT_TAG" --verify-tag --title "$GIT_TAG" --generate-notes $PRERELEASE dist/*
        """#
    }
  }
}

testReports {
  junit {
    "test-results/**/*.xml"
  }
  excludeJobs {
    Regex("check-.*")
    Regex("image-.*")
    "github-release"
  }
}

prb {
  jobs {
    ["test"] = test
    ["check-image"] = imageBuild(false, false)
  }
}

build {
  jobs {
    ["test"] = test
  }
}

main {
  jobs {
    ["test"] = test
    ["image-build"] = (imageBuild(true, false)) { needs = "test" }
    ["image-merge"] = imageMerge("type=edge,branch=main\ntype=sha")
  }
}

release {
  jobs {
    ["check-version"] = checkVersion
    ["test"] = test
    ["image-build"] = (imageBuild(true, true)) {
      needs {
        "check-version"
        "test"
      }
    }
    ["image-merge"] = imageMerge("type=semver,pattern={{version}}\ntype=semver,pattern={{major}}.{{minor}}")
    ["github-release"] = githubRelease
  }
}

workflows {
  // The user docs on GitHub Pages; was the hand-written .github/workflows/docs.yml.
  ["workflows/docs.yml"] = new Workflow {
    name = "Docs"
    on {
      push {
        branches {
          "main"
        }
        paths {
          "docs/**"
          "docs_site/**"
          "assets/css/tokens.css"
          "assets/css/media.css"
          "priv/static/fonts/**"
          "priv/static/images/logo.svg"
          "mise.toml"
          ".github/index.pkl"
        }
      }
      workflow_dispatch {}
    }
    permissions {
      contents = "read"
      pages = "write"
      `id-token` = "write"
    }
    concurrency {
      group = "pages"
      `cancel-in-progress` = false
    }
    jobs {
      ["build"] {
        `runs-on` = runner
        steps {
          catalog.`actions/checkout@v6`
          mise
          (catalog.`actions/configure-pages@v5`) {
            id = "pages"
          }
          new {
            run = "mise run docs:build"
            env {
              ["MYTHWEAVER_DOCS_URL"] = context.steps.outputs("pages", "base_url")
              ["MYTHWEAVER_DOCS_BASE_PATH"] = context.steps.outputs("pages", "base_path")
            }
          }
          (catalog.`actions/upload-pages-artifact@v4`) {
            with {
              path = "docs_site/_site"
            }
          }
        }
      }
      ["deploy"] {
        needs = "build"
        `runs-on` = runner
        environment {
          name = "github-pages"
          url = context.steps.outputs("deployment", "page_url")
        }
        steps {
          (catalog.`actions/deploy-pages@v4`) {
            id = "deployment"
          }
        }
      }
    }
  }
}
